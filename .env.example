# Database
DATABASE_URL=postgresql+asyncpg://procuresignal:procuresignal@postgres:5432/procuresignal
SQLALCHEMY_ECHO=false
POSTGRES_HOST_PORT=5434

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_HOST_PORT=6380

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENABLE_APSCHEDULER=false

# Worker
WORKER_CONCURRENCY=4

# LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano

# Auth (REQUIRED). Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# There is no default. A shipped default secret looks like authentication while providing none.
AUTH_SECRET_KEY=
# Set true ONLY for local http development; it drops the Secure flag on the refresh cookie.
AUTH_COOKIE_INSECURE=false
# Browser origins allowed to call the API with credentials. Comma separated.
# '*' is refused: browsers reject it alongside credentials, and it would expose
# every user's data to any site if they did not.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# News APIs
NEWSAPI_KEY=
GDELT_ENABLED=false

# Registry source overrides (true/false only). Defaults mirror sources-v1.
SOURCE_EU_COMMISSION_PRESS_ENABLED=true
SOURCE_EU_COUNCIL_PRESS_ENABLED=false
SOURCE_ECB_PRESS_ENABLED=true
# The sealed adapter streams this source with a separate 32 MiB ceiling.
# Missing EU_FISMA_SANCTIONS_TOKEN is isolated as a non-retryable source configuration failure.
SOURCE_EU_FINANCIAL_SANCTIONS_ENABLED=true
SOURCE_EUROSTAT_UPDATES_ENABLED=true
SOURCE_FREIGHTWAVES_ENABLED=false
SOURCE_MINING_COM_ENABLED=true
SOURCE_OILPRICE_ENABLED=true
SOURCE_SUPPLY_CHAIN_DIVE_ENABLED=true
SOURCE_DW_BUSINESS_ENABLED=true

# Frontend (browser-facing; point at the host-published API)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# Deployment secret forwarded to retrieval-capable services for the DG FISMA XML distribution.
# Never place a production token in source control.
EU_FISMA_SANCTIONS_TOKEN=
