{
  "uid": "procuresignal-operations",
  "title": "ProcureSignal Operations",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "procuresignal",
    "operations"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Target health",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "procuresignal-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"procuresignal-api|procuresignal-worker\"}",
          "legendFormat": "{{job}}{{stage}}{{source_id}}{{task}}{{tenant}}{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "API availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "procuresignal-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "procuresignal:api_availability:ratio_5m",
          "legendFormat": "{{job}}{{stage}}{{source_id}}{{task}}{{tenant}}{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "API p95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "procuresignal-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "procuresignal:api_latency_p95_seconds:5m",
          "legendFormat": "{{job}}{{stage}}{{source_id}}{{task}}{{tenant}}{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Pipeline age",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "procuresignal-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - procuresignal_pipeline_last_success_timestamp",
          "legendFormat": "{{job}}{{stage}}{{source_id}}{{task}}{{tenant}}{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 21600
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Retrieval failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "procuresignal-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source_id) (increase(procuresignal_retrieval_articles_total{outcome!=\"success\"}[8h]))",
